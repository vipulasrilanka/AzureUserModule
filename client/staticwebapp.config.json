{
  "auth": {
    "identityProviders": {
      "azureActiveDirectoryB2C": {
        "registration": {
          "clientIdSettingName": "B2C_CLIENT_ID",
          "clientSecretSettingName": "B2C_CLIENT_SECRET",
          "tenantId": "YOUR_B2C_TENANT_ID"
        }
      }
    }
  },
  "routes": [
    {
      "route": "/api/settings",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/*",
      "serve": "/index.html",
      "statusCode": 200
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/images/*.{png,jpg,gif}", "/css/*"]
  },
  "globalHeaders": {
    "content-security-policy": "default-src https: 'unsafe-eval' 'unsafe-inline'; object-src 'none'"
  },
  "mimeTypes": {
    ".json": "text/json"
  }
}
